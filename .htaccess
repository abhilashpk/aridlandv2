<IfModule mod_rewrite.c>
    RewriteEngine On

    # If file or directory exists, serve it
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise redirect everything to public/
    RewriteRule ^ public/$1 [L]
</IfModule>



